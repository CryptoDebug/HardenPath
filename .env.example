# Used by Prisma when you run the app locally with npm.
DATABASE_URL="postgresql://hardenpath:hardenpath_dev_password@localhost:5433/hardenpath?schema=public"

# Used by Docker Compose for the PostgreSQL container.
POSTGRES_DB="hardenpath"
POSTGRES_USER="hardenpath"
POSTGRES_PASSWORD="hardenpath_dev_password"
POSTGRES_PORT="5433"

# Used by NextAuth.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-with-a-random-secret"

# Optional comma-separated hosts when opening the dev server through another interface.
ALLOWED_DEV_ORIGINS=""

# Set true only when a trusted reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY="false"

# Optional email verification and password reset delivery through Resend.
REQUIRE_EMAIL_VERIFICATION="false"
RESEND_API_KEY=""
EMAIL_FROM="HardenPath <noreply@example.com>"
